<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>locrec_ros</name>
  <version>0.1.0</version>
  <description>Publishes localizability and a recommended action from a LiDAR stream.</description>
  <maintainer email="64199670+SaurabhKhimesra@users.noreply.github.com">Saurabh Khimesra</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- the Python tf2_ros module is in tf2_ros_py; the tf2_ros package is the C++ one
       and does not depend on it, so naming tf2_ros leaves the import unresolved -->
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>locrec</exec_depend>
  <exec_depend>locrec_msgs</exec_depend>
  <!-- the launch files here start the C++ estimator node -->
  <exec_depend>locrec_estimator</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- the viewer and the CPU renderer draw their overlay with Pillow -->
  <exec_depend>python3-pil</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
